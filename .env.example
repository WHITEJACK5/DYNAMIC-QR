# NARE & CO. — Environment Configuration
#
# LOCAL DEVELOPMENT ONLY. Copy to .env and set your own values.
# Never commit .env to git (it is git-ignored, and CI fails if it appears).
#
# STAGING / PRODUCTION: do not use this file. Set the variables in your
# host's secret store, which injects them as environment variables:
#
#   Render     Dashboard > your service > Environment > Add secret
#   Railway    project > Variables > add SECRET_KEY
#   Fly.io     fly secrets set SECRET_KEY=...
#   AWS        Secrets Manager / SSM, exported by the task definition
#
# The app refuses to start in production without SECRET_KEY, and refuses to
# read a .env file there, so a stale file cannot shadow an injected secret.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# APP_ENV=production is detected automatically on Render/Railway/Fly/
# Heroku/Kubernetes; set it explicitly anywhere else.
# APP_ENV=development

# Required. At least 32 characters; the app refuses shorter values in
# production.
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET=change-me-optional-defaults-to-SECRET_KEY
BASE_URL=http://localhost:5000
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=5 per minute
# Optional: Geo IP service (ip-api.com is free, no key)
# IPAPI_URL=http://ip-api.com/json

# ---------------------------------------------------------------------------
# Database (Phase 3)
# Leave DATABASE_URL unset and the app uses local SQLite at data/nare.db
# (fresh-clone default). Set it to PostgreSQL to switch the whole app over —
# same code, no SQLite-only paths remain.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/nare
# Connection pool (PostgreSQL only; each gunicorn/RQ worker gets its own pool)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Logo storage (Phase 3d)
# REQUIRED for logo uploads. Logos go to S3-compatible object storage and the
# database stores an s3:// reference. There is no silent local fallback: with
# no bucket configured, a logo upload returns 503 instead of writing to a
# container's ephemeral disk.
# ---------------------------------------------------------------------------
# S3_BUCKET=nare-logos
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # Cloudflare R2
# S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com          # Backblaze B2
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Dev/test only. Opt-in local disk storage for a single-process loop; never
# set this in production, where a container restart loses every logo.
# ALLOW_LOCAL_STORAGE=1

# ---------------------------------------------------------------------------
# Redis: rate limiting, job queue, cache. Unset = in-process fallbacks.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
