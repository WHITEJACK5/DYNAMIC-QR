# DR & CO. — backup schedule (systemd timer).
#
# Paired with DR-backup.service. Enable both:
#   sudo cp deploy/DR-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now DR-backup.timer
#
# Deliberately randomized within the day (OnCalendar with a spread) so the
# dump does not always land on the same minute as every other cron job on
# the host. Persistent=true means a missed run (machine off) fires on boot.

[Unit]
Description=Run the DR & CO. PostgreSQL backup daily at 03:17
Documentation=file:///srv/DR/README.md

[Timer]
OnCalendar=*-*-* 03:17:00
# Re-run once if the machine was asleep/off at the scheduled time.
Persistent=true
# Spread load if several timers fire together.
RandomizedDelaySec=600
Unit=DR-backup.service

[Install]
WantedBy=timers.target
