// Lighthouse CI configuration (Phase 8d).
#
// The directive: "Add basic performance budgeting — Lighthouse CI in the
// pipeline with a score threshold that fails the build if regressed."
#
// The thresholds are the contract. They are set at a level the current
// frontend can actually meet — a budget nobody can hit is a budget that gets
// disabled within a week — while still catching a real regression.
#
//   performance      80   (the raw-HTML frontend is small; 80 is honest)
//   accessibility    90   (WCAG AA is the stated goal)
//   best-practices   90
//   seo              90
#
// `ci:assert` in the workflow turns the accessibility and best-practices
// categories into hard failures. Performance is a warning here because a
// single Lighthouse run on a shared runner is noisy; raise it to error once
// the baseline is stable.

ci:
  collect:
    numberOfRuns: 3
    settings:
      formFactor: desktop
      screenEmulation:
        mobile: false
        width: 1350
        height: 940
        deviceScaleFactor: 1
        disabled: false
      throttlingMethod: simulate
  upload:
    target: temporary-public-storage
  assert:
    preset: "lighthouse:recommended"
    assertions:
      "categories:performance": ["warn", { "minScore": 0.8 }]
      "categories:accessibility": ["error", { "minScore": 0.9 }]
      "categories:best-practices": ["error", { "minScore": 0.9 }]
      "categories:seo": ["error", { "minScore": 0.9 }]
      // a regression in these is a build failure, not a warning
      "first-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
